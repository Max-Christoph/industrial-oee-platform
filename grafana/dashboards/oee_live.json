{
  "uid": "oee-live",
  "title": "OEE Live",
  "tags": [
    "oee"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "asset",
        "label": "Asset",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "oee-timescaledb"
        },
        "query": "SELECT asset_id FROM core.assets WHERE asset_type = 'machine' UNION SELECT DISTINCT asset_id FROM mart.cycle_metrics WHERE bucket > now() - interval '7 days' ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "allValue": "'All'",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Seconds since last event",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oee-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oee-timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT seconds_since_last_event FROM mart.v_pipeline_health"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Seconds since last aggregation",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oee-timescaledb"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oee-timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT seconds_since_last_aggregation FROM mart.v_pipeline_health"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 180
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pipeline errors (1 h)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oee-timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oee-timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT errors_last_hour FROM mart.v_pipeline_health"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cycles in range",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oee-timescaledb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oee-timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(cycle_count),0) AS cycles FROM mart.cycle_metrics WHERE $__timeFilter(bucket) AND ('All' IN ($asset) OR asset_id IN ($asset))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cycle time median / p95 per asset",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oee-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oee-timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, asset_id || ' median' AS metric, cycle_median_s AS value FROM mart.cycle_metrics WHERE $__timeFilter(bucket) AND ('All' IN ($asset) OR asset_id IN ($asset)) AND cycle_count > 0 UNION ALL SELECT bucket, asset_id || ' p95', cycle_p95_s FROM mart.cycle_metrics WHERE $__timeFilter(bucket) AND ('All' IN ($asset) OR asset_id IN ($asset)) AND cycle_count > 0 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Downtime & microstops (minutes per hour)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oee-timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oee-timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, sum(downtime_s)/60 AS downtime, sum(microstop_s)/60 AS microstops, sum(setup_s)/60 AS setup FROM mart.cycle_metrics WHERE $__timeFilter(bucket) AND ('All' IN ($asset) OR asset_id IN ($asset)) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingested events per minute",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oee-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oee-timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 minute', received_at) AS time, count(*) AS events FROM core.events WHERE $__timeFilter(event_datetime) AND received_at > now() - interval '24 hours' GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Latest stops",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oee-timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oee-timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT start_time, asset_path, stop_class, event_category, event_code, round(duration_s::numeric,1) AS duration_s FROM mart.v_stop_events WHERE $__timeFilter(start_time) AND ('All' IN ($asset) OR asset_id IN ($asset)) ORDER BY start_time DESC LIMIT 100"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Pipeline errors",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oee-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oee-timescaledb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT logged_at, source, error_type, message, topic FROM core.error_logs WHERE $__timeFilter(logged_at) ORDER BY logged_at DESC LIMIT 100"
        }
      ]
    }
  ]
}
