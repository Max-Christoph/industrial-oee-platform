# industrial-oee-platform - environment template
# `make env` copies this file to .env and replaces every __GENERATE__ with a random secret.
# NEVER commit .env. Plant / IT specifics belong in .env or site_overrides/ only.

# --- Site ---------------------------------------------------------------------
SITE_TIMEZONE=Europe/Berlin
LOG_LEVEL=INFO
# Extra DNS names / IPs for the self-signed certificate (comma separated)
CERT_HOSTNAMES=localhost,127.0.0.1

# --- Corporate network (build-time proxy / internal mirrors) -----------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,timescaledb,mosquitto
UV_INDEX_URL=
# Override images to point at an internal registry, e.g. registry.corp.example/timescale/timescaledb:2.17.2-pg16
# TIMESCALEDB_IMAGE=
# MOSQUITTO_IMAGE=
# GRAFANA_IMAGE=
# PYTHON_IMAGE=

# --- PostgreSQL / TimescaleDB -------------------------------------------------
POSTGRES_DB=oee
POSTGRES_PASSWORD=__GENERATE__
OEE_APP_PASSWORD=__GENERATE__
GRAFANA_DB_PASSWORD=__GENERATE__
BI_DB_PASSWORD=__GENERATE__
AI_DB_PASSWORD=__GENERATE__
PG_PORT=5432
PG_PUBLISH_ADDRESS=0.0.0.0
PG_SHARED_BUFFERS=1GB
PG_MAX_WAL_SIZE=2GB
PG_SSL_ONLY_REMOTE=true

# --- MQTT ---------------------------------------------------------------------
MQTT_INGEST_USER=oee_ingest
MQTT_INGEST_PASSWORD=__GENERATE__
MQTT_DEVICE_USER=oee_device
MQTT_DEVICE_PASSWORD=__GENERATE__
MQTT_TLS_PORT=8883
MQTT_PUBLISH_ADDRESS=0.0.0.0
MQTT_TOPIC=oee/#
# Loopback port for the plaintext broker listener in `make dev`
MQTT_DEV_PORT=1883

# --- Ingest tuning ------------------------------------------------------------
BATCH_MAX_SIZE=1000
BATCH_MAX_WAIT_MS=250
MAX_CYCLE_TIME_S=86400
MAX_FUTURE_SKEW_S=300

# --- API gateway --------------------------------------------------------------
# Comma separated, each >= 16 characters
API_KEYS=__GENERATE__
API_PORT=8000
API_PUBLISH_ADDRESS=0.0.0.0

# --- MCP server (no built-in auth -> loopback by default) ---------------------
MCP_PORT=8001
MCP_PUBLISH_ADDRESS=127.0.0.1

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE__
GRAFANA_PORT=3000
GRAFANA_PUBLISH_ADDRESS=0.0.0.0
GRAFANA_ROOT_URL=http://localhost:3000/
# Corporate SSO (OIDC) - set ENABLED=true and fill in your IdP endpoints
GF_AUTH_GENERIC_OAUTH_ENABLED=false
GF_AUTH_GENERIC_OAUTH_NAME=Corporate SSO
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=
GF_AUTH_GENERIC_OAUTH_AUTH_URL=
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=
GF_AUTH_GENERIC_OAUTH_API_URL=
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=
# Alternative: reverse proxy authentication (e.g. corporate SSO gateway)
GF_AUTH_PROXY_ENABLED=false
GF_AUTH_PROXY_HEADER_NAME=X-WEBAUTH-USER
GF_AUTH_PROXY_WHITELIST=
